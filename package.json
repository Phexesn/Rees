{
  "name": "realtyboost",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run gen:registry && next dev",
    "build": "npm run gen:registry && prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "gen:registry": "tsx scripts/gen-registry.ts",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx --conditions=react-server scripts/seed.ts",
    "check:locales": "tsx scripts/check-locales.ts",
    "walkthrough": "tsx --conditions=react-server scripts/walkthrough.ts",
    "postinstall": "prisma generate",
    "vercel-build": "prisma migrate deploy && npm run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "@prisma/client": "^6.19.3",
    "ajv": "^8.20.0",
    "bcryptjs": "^3.0.3",
    "next": "15.5.28",
    "next-intl": "^4.14.9",
    "prisma": "^6.19.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "server-only": "^0.0.1",
    "stripe": "^23.1.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
