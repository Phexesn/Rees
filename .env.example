# Copy to .env and fill in. Never commit real values.

# Postgres (Neon / Supabase / local). The app role must NOT be a superuser (RLS).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/realtyboost"
APP_URL="http://localhost:3000"

# Comma-separated emails that can open /admin
ADMIN_EMAILS=""

# AI providers — set at least one in production.
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
GOOGLE_API_KEY=""
# Optional: force every prompt onto one provider (anthropic | openai | google | mock)
LLM_PROVIDER=""
# Optional: model to use when LLM_PROVIDER forces a provider, e.g. LLM_MODEL_OPENAI="gpt-5-mini"
LLM_MODEL_ANTHROPIC=""
LLM_MODEL_OPENAI=""
LLM_MODEL_GOOGLE=""

# Stripe (test mode keys start with sk_test_). Without a key, dev billing mode lets you switch plans.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_SOLO=""
STRIPE_PRICE_PRO=""
STRIPE_PRICE_TEAM=""

# Transactional email (new-lead alerts). Without a key, emails are logged instead.
RESEND_API_KEY=""
EMAIL_FROM="RealtyBoost <alerts@yourdomain.com>"
